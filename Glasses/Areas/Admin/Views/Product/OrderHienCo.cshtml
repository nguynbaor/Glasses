@model IEnumerable<Glasses.Models.DonHang>

@{
    ViewData["Title"] = "Đơn hàng hiện có";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    int stt = 1;
}

<div class="main-content-wrap">
    <!-- Tiêu đề & Breadcrumb -->
    <div class="flex items-center flex-wrap justify-between gap20 mb-27">
        <h3>Quản lý đơn hàng</h3>
        <ul class="breadcrumbs flex items-center flex-wrap justify-start gap10">
            <li>
                <a href="/Admin/Home/Index">
                    <div class="text-tiny">Tổng quan</div>
                </a>
            </li>
            <li>
                <i class="icon-chevron-right"></i>
            </li>
            <li>
                <div class="text-tiny">Đơn hàng hiện có</div>
            </li>
        </ul>
    </div>

    <div class="wg-box">
        <!-- Thanh tìm kiếm -->
        <div class="flex items-center justify-between gap10 flex-wrap">
            <div class="wg-filter flex-grow">
                <form class="form-search" method="get" action="/Admin/Product/OrderHienCo">
                    <fieldset class="name">
                        <input type="text" placeholder="Tìm theo mã đơn, tên hoặc số điện thoại..." class="" name="search"
                               tabindex="2" value="@Context.Request.Query["search"]" aria-required="true">
                    </fieldset>
                    <div class="button-submit">
                        <button class="" type="submit"><i class="icon-search"></i></button>
                    </div>
                </form>
            </div>
        </div>

        <!-- Bảng danh sách đơn hàng -->
        <div class="wg-table table-all-user">
            <div class="table-responsive">
                <table class="table table-striped table-bordered">
                    <thead>
                        <tr>
                            <th style="width:60px" class="text-center">STT</th>
                            <th class="text-center">Mã đơn</th>
                            <th class="text-center">Tên khách hàng</th>
                            <th class="text-center">Số điện thoại</th>
                            <th class="text-center">Tổng tiền</th>
                            <th class="text-center">Trạng thái</th>
                            <th class="text-center">Ngày đặt</th>
                            <th class="text-center">Số lượng sản phẩm</th>
                            <th class="text-center" style="width:100px">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td class="text-center">@(stt++)</td>
                                    <td class="text-center fw-bold">#@item.MaDonHang</td>
                                    <td class="text-center text-danger fw-bold">
                                        @string.Format("{0:N0} VNĐ", item.TongTien)
                                    </td>
                                    <td class="text-center">
                                        @if (item.TrangThai == "Đã giao" || item.TrangThai == "Hoàn thành")
                                        {
                                            <span class="badge bg-success p-2">@item.TrangThai</span>
                                        }
                                        else if (item.TrangThai == "Đang giao" || item.TrangThai == "Đã xác nhận")
                                        {
                                            <span class="badge bg-primary p-2">@item.TrangThai</span>
                                        }
                                        else if (item.TrangThai == "Đã hủy")
                                        {
                                            <span class="badge bg-danger p-2">@item.TrangThai</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning text-dark p-2">@(string.IsNullOrEmpty(item.TrangThai) ? "Chờ xử lý" : item.TrangThai)</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        @(item.NgayDat.HasValue? item.NgayDat.Value.ToString("dd/MM/yyyy HH:mm") : "-")
                                    </td>
                                    <td class="text-center">
                                        <span class="badge bg-secondary">
                                            @(item.ChiTietDonHangs?.Sum(c => c.SoLuong) ?? 0)
                                        </span>
                                    </td>
                                    <td class="text-center">
                                        <a href="/Admin/Product/OrderDetail/@item.MaDonHang" title="Xem chi tiết">
                                            <div class="list-icon-function view-icon justify-content-center">
                                                <div class="item eye">
                                                    <i class="icon-eye"></i>
                                                </div>
                                            </div>
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="9" class="text-center">Không tìm thấy đơn hàng nào.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="divider"></div>
        <div class="flex items-center justify-between flex-wrap gap10 wgp-pagination">
            <div class="text-tiny">
                Hiển thị @(Model?.Count() ?? 0) đơn hàng
            </div>
        </div>
    </div>
</div>