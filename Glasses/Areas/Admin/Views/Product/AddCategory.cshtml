@model Glasses.Models.DanhMuc

@{
    ViewData["Title"] = "Thêm danh mục";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="main-content-wrap">
    <!-- Tiêu đề & Breadcrumb -->
    <div class="flex items-center flex-wrap justify-between gap20 mb-27">
        <h3>Thêm danh mục mới</h3>
        <ul class="breadcrumbs flex items-center flex-wrap justify-start gap10">
            <li>
                <a href="/Admin/Home/Index">
                    <div class="text-tiny">Tổng quan</div>
                </a>
            </li>
            <li>
                <i class="icon-chevron-right"></i>
            </li>
            <li>
                <a href="/Admin/Product/CategoryHienCo">
                    <div class="text-tiny">Danh mục</div>
                </a>
            </li>
            <li>
                <i class="icon-chevron-right"></i>
            </li>
            <li>
                <div class="text-tiny">Thêm mới</div>
            </li>
        </ul>
    </div>

    <!-- Form nhập liệu -->
    <div class="wg-box">
        <form class="form-new-product form-style-1"
              action="/Admin/Product/AddCategory"
              method="POST"
              data-ajax="false">

            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <!-- Mã danh mục -->
            <fieldset class="name">
                <div class="body-title">Mã danh mục <span class="tf-color-1">*</span></div>
                <input class="flex-grow" type="text"
                       asp-for="MaDanhMuc"
                       placeholder="Nhập mã danh mục (VD: DM01)"
                       required>
                <span asp-validation-for="MaDanhMuc" class="text-danger"></span>
            </fieldset>

            <!-- Tên danh mục -->
            <fieldset class="name">
                <div class="body-title">Tên danh mục <span class="tf-color-1">*</span></div>
                <input class="flex-grow" type="text"
                       asp-for="TenDanhMuc"
                       placeholder="Nhập tên danh mục (VD: Kính cận, Kính mát...)"
                       required>
                <span asp-validation-for="TenDanhMuc" class="text-danger"></span>
            </fieldset>

            <!-- Nút bấm -->
            <div class="bot flex gap10 justify-end">
                <button class="tf-button w208" type="submit">Lưu danh mục</button>
                <a href="/Admin/Product/CategoryHienCo" class="tf-button style-2 w208 text-center">Hủy bỏ</a>
            </div>
        </form>
    </div>
</div>