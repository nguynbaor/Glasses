@model Glasses.Models.SanPham

@{
    ViewData["Title"] = "Chi tiết sản phẩm";
}

<div class="container mt-5">
    <div class="row">
        <div class="col-md-5">
            <img src="~/Admin/images/products/@Model.HinhAnh"
                 class="img-fluid rounded"
                 alt="@Model.TenSanPham" />
        </div>

        <div class="col-md-7">
            <h2>@Model.TenSanPham</h2>

            <p>Thương hiệu: @Model.ThuongHieu?.TenThuongHieu</p>

            <p>Danh mục: @Model.DanhMuc?.TenDanhMuc</p>

            <h4 class="text-danger">
                @Model.GiaDaGiam.ToString("N0") VNĐ
            </h4>

            <p>@Model.ThongTin</p>

            <form id="addCartForm">
                <label>Chọn màu kính</label>

                <select id="variantId" class="form-control">
                    @foreach (var item in Model.BienThes ?? new())
                    {
                        <option value="@item.MaBienThe"
                                disabled="@(item.SoLuongTon <= 0)">
                            @item.MauSac - Còn @item.SoLuongTon
                        </option>
                    }
                </select>

                <label class="mt-3">Số lượng</label>

                <input type="number"
                       id="quantity"
                       class="form-control"
                       value="1"
                       min="1"
                       max="50" />

                <button type="button"
                        class="btn btn-primary mt-3"
                        onclick="addToCart()">
                    Thêm vào giỏ hàng
                </button>
            </form>
        </div>
    </div>
</div>
