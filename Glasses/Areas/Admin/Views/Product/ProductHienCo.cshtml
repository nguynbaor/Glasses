@model IEnumerable<Glasses.Models.SanPham>

@{
    ViewData["Title"] = "Sản phẩm hiện có";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    int stt = 1;
}

<div class="main-content-wrap">

    <!-- Tiêu đề trang -->
    <div class="flex items-center flex-wrap justify-between gap20 mb-27">
        <h3>Danh sách sản phẩm</h3>

        <ul class="breadcrumbs flex items-center flex-wrap justify-start gap10">
            <li>
                <a href="/Admin/Home/Index">
                    <div class="text-tiny">Tổng quan</div>
                </a>
            </li>
            <li>
                <i class="icon-chevron-right"></i>
            </li>
            <li>
                <div class="text-tiny">Danh sách sản phẩm</div>
            </li>
        </ul>
    </div>

    <!-- Danh sách sản phẩm -->
    <div class="wg-box">

        <div class="flex items-center justify-between gap10 flex-wrap">
            <div class="wg-filter flex-grow">
                <form class="form-search" method="get">
                    <fieldset class="name">
                        <input type="text"
                               placeholder="Tìm kiếm sản phẩm..."
                               name="search"
                               class="show-search">
                    </fieldset>
                    <div class="button-submit">
                        <button type="submit">
                            <i class="icon-search"></i>
                        </button>
                    </div>
                </form>
            </div>

            <a class="tf-button style-1 w208" href="/Admin/Product/AddProduct">
                <i class="icon-plus"></i>
                Thêm sản phẩm
            </a>
        </div>

        <!-- Bảng sản phẩm -->
        <div class="wg-table table-all-user">
            <div class="table-responsive">
                <table class="table table-striped table-bordered">
                    <thead>
                        <tr>
                            <th>STT</th>
                            <th>Tên sản phẩm</th>
                            <th>Giá gốc</th>
                            <th>Mã SKU</th>
                            <th>Danh mục</th>
                            <th>Thương hiệu</th>
                            <th>Chất liệu</th>
                            <th>Thao tác</th>
                        </tr>
                    </thead>

                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            @foreach (var item in Model)
                            {
                                string defaultImg = Url.Content("~/Admin/images/products/default.png");
                                string imgSrc = defaultImg;

                                if (!string.IsNullOrEmpty(item.HinhAnh))
                                {
                                    if (item.HinhAnh.StartsWith("http://") || item.HinhAnh.StartsWith("https://"))
                                    {
                                        imgSrc = item.HinhAnh;
                                    }
                                    else if (item.HinhAnh.StartsWith("~/") || item.HinhAnh.StartsWith("/"))
                                    {
                                        imgSrc = Url.Content(item.HinhAnh);
                                    }
                                    else
                                    {
                                        imgSrc = Url.Content("~/Admin/images/products/" + item.HinhAnh);
                                    }
                                }

                                <tr>
                                    <td>@(stt++)</td>
                                    <td>
                                        <div class="flex items-center gap10">
                                            <div class="image" style="width: 50px; height: 50px; min-width: 50px; flex-shrink: 0; overflow: hidden; border-radius: 6px; background-color: #f8f9fa;">
                                                <img src="@imgSrc"
                                                     alt="@item.TenSanPham"
                                                     onerror="this.onerror=null; this.src='@defaultImg';"
                                                     style="width: 100%; height: 100%; object-fit: contain; display: block;">
                                            </div>
                                            <div>
                                                <a href="/Admin/Product/Details/@item.MaSanPham" class="body-title-2">
                                                    @item.TenSanPham
                                                </a>
                                            </div>
                                        </div>
                                    </td>

                                    <td>@item.Gia.ToString("N0") ₫</td>

                                    <td>@item.MaSanPham</td>

                                    <td>@(item.DanhMuc?.TenDanhMuc ?? "Chưa phân loại")</td>
                                    <td>@(item.ThuongHieu?.TenThuongHieu ?? "Chưa có")</td>
                                    <td>@(item.ChatLieu ?? "N/A")</td>

                                    <td>
                                        <div class="list-icon-function">
                                            <a href="/Admin/Product/Details/@item.MaSanPham" title="Xem chi tiết">
                                                <i class="icon-eye"></i>
                                            </a>
                                            <a href="/Admin/Product/Edit/@item.MaSanPham" title="Chỉnh sửa">
                                                <i class="icon-edit-3"></i>
                                            </a>
                                            <a href="/Admin/Product/Delete/@item.MaSanPham" title="Xóa sản phẩm" onclick="return confirm('Bạn có chắc muốn xóa sản phẩm này?');">
                                                <i class="icon-trash-2"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="8" class="text-center">Chưa có dữ liệu sản phẩm.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="divider"></div>

            <div class="flex items-center justify-between flex-wrap gap10">
                <div class="text-tiny">
                    Hiển thị @(Model?.Count() ?? 0) sản phẩm
                </div>

                <ul class="wg-pagination">
                    <li>
                        <a href="#"><i class="icon-chevron-left"></i></a>
                    </li>
                    <li class="active">
                        <a href="#">1</a>
                    </li>
                    <li>
                        <a href="#"><i class="icon-chevron-right"></i></a>
                    </li>
                </ul>
            </div>

        </div>
    </div>
</div>