@model Glasses.Models.SanPham

@{
    ViewData["Title"] = "Thêm Sản phẩm";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="main-content-wrap">

    <div class="flex items-center flex-wrap justify-between gap20 mb-27">
        <h3>Thêm sản phẩm</h3>

        <ul class="breadcrumbs flex items-center flex-wrap justify-start gap10">
            <li>
                <a href="/Admin/Home/Index">
                    <div class="text-tiny">Tổng quan</div>
                </a>
            </li>
            <li><i class="icon-chevron-right"></i></li>
            <li>
                <a href="/Admin/Product/ProductHienCo">
                    <div class="text-tiny">Sản phẩm</div>
                </a>
            </li>
            <li><i class="icon-chevron-right"></i></li>
            <li>
                <div class="text-tiny">Thêm sản phẩm</div>
            </li>
        </ul>
    </div>

    <form class="tf-section-2"
          action="/Admin/Product/AddProduct"
          method="POST"
          enctype="multipart/form-data"
          data-ajax="false"
          onsubmit="return true;">

        @Html.AntiForgeryToken()

        <div class="wg-box">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <!-- Mã sản phẩm (SKU) -->
            <fieldset class="name">
                <div class="body-title mb-10">
                    Mã sản phẩm (SKU) <span class="tf-color-1">*</span>
                </div>
                <input class="mb-10" type="text"
                       asp-for="MaSanPham"
                       placeholder="Nhập mã sản phẩm (VD: SP001)" required>
                <span asp-validation-for="MaSanPham" class="text-danger"></span>
            </fieldset>

            <!-- Tên sản phẩm -->
            <fieldset class="name">
                <div class="body-title mb-10">
                    Tên sản phẩm <span class="tf-color-1">*</span>
                </div>
                <input class="mb-10" type="text"
                       asp-for="TenSanPham"
                       placeholder="Nhập tên sản phẩm" required>
                <span asp-validation-for="TenSanPham" class="text-danger"></span>
            </fieldset>

            <!-- Danh mục và Thương hiệu -->
            <div class="gap22 cols">
                <fieldset class="category">
                    <div class="body-title mb-10">
                        Danh mục <span class="tf-color-1">*</span>
                    </div>
                    <select asp-for="MaDanhMuc" class="form-control">
                        <option value="">-- Chọn danh mục --</option>
                        @if (ViewBag.DanhMucs != null)
                        {
                            foreach (var item in (IEnumerable<Glasses.Models.DanhMuc>)ViewBag.DanhMucs)
                            {
                                <option value="@item.MaDanhMuc">@item.TenDanhMuc</option>
                            }
                        }
                    </select>
                </fieldset>

                <fieldset class="brand">
                    <div class="body-title mb-10">
                        Thương hiệu
                    </div>
                    <select asp-for="MaThuongHieu" class="form-control">
                        <option value="">-- Chọn thương hiệu --</option>
                        @if (ViewBag.ThuongHieus != null)
                        {
                            foreach (var item in (IEnumerable<Glasses.Models.ThuongHieu>)ViewBag.ThuongHieus)
                            {
                                <option value="@item.MaThuongHieu">@item.TenThuongHieu</option>
                            }
                        }
                    </select>
                </fieldset>
            </div>

            <!-- Mô tả chi tiết -->
            <fieldset class="description">
                <div class="body-title mb-10">
                    Mô tả chi tiết
                </div>
                <textarea class="mb-10"
                          asp-for="ThongTin"
                          placeholder="Nhập mô tả chi tiết về sản phẩm"></textarea>
                <span asp-validation-for="ThongTin" class="text-danger"></span>
            </fieldset>

        </div>

        <div class="wg-box">

            <!-- Upload ảnh sản phẩm -->
            <fieldset>
                <div class="body-title mb-10">
                    Ảnh đại diện sản phẩm
                </div>

                <div class="upload-image flex-grow flex items-center gap20">
                    <div class="item" id="imgpreview" style="display:none; max-width: 180px; width: 100%;">
                        <img id="preview-file-img" src="#" class="effect8" alt="Ảnh xem trước"
                             style="width: 100%; height: 180px; object-fit: contain; border-radius: 8px; border: 1px solid #e0e0e0; padding: 4px;" />
                    </div>

                    <div id="upload-file" class="item up-load flex-grow">
                        <label class="uploadfile" for="myFile" style="cursor: pointer;">
                            <span class="icon">
                                <i class="icon-upload-cloud"></i>
                            </span>
                            <span class="body-text">
                                Thả ảnh vào đây hoặc
                                <span class="tf-color">nhấn để chọn ảnh</span>
                            </span>
                            <input type="file" id="myFile" name="HinhAnhFile" accept="image/*" onchange="previewImage(this)">
                        </label>
                    </div>
                </div>
            </fieldset>

            <!-- Giá sản phẩm & % Giảm giá -->
            <div class="cols gap22">
                <fieldset class="name">
                    <div class="body-title mb-10">
                        Giá gốc (VNĐ) <span class="tf-color-1">*</span>
                    </div>
                    <input class="mb-10" type="number"
                           asp-for="Gia"
                           placeholder="Nhập giá gốc" required>
                    <span asp-validation-for="Gia" class="text-danger"></span>
                </fieldset>

                <fieldset class="name">
                    <div class="body-title mb-10">
                        Giảm giá (%)
                    </div>
                    <input class="mb-10" type="number"
                           asp-for="PhanTramGiam"
                           placeholder="0" min="0" max="100">
                    <span asp-validation-for="PhanTramGiam" class="text-danger"></span>
                </fieldset>
            </div>

            <!-- Chất liệu -->
            <div class="cols gap22">
                <fieldset class="name">
                    <div class="body-title mb-10">
                        Chất liệu
                    </div>
                    <input class="mb-10" type="text"
                           asp-for="ChatLieu"
                           placeholder="Nhựa TR90, Titanium, Acetate...">
                    <span asp-validation-for="ChatLieu" class="text-danger"></span>
                </fieldset>
            </div>

            <!-- Nút submit và Hủy bỏ -->
            <div class="cols gap10">
                <button class="tf-button w-full" type="submit">
                    Lưu sản phẩm
                </button>
                <a href="/Admin/Product/ProductHienCo" class="tf-button style-2 w-full text-center">
                    Hủy bỏ
                </a>
            </div>

        </div>
    </form>
</div>

@section Scripts {
    <script>
        function previewImage(input) {
            if (input.files && input.files[0]) {
                var reader = new FileReader();
                reader.onload = function (e) {
                    $('#preview-file-img').attr('src', e.target.result);
                    $('#imgpreview').fadeIn();
                }
                reader.readAsDataURL(input.files[0]);
            }
        }
    </script>
}